        "inflation api",
        "inflation rate api",
        "api for inflation rates",
        "cpi api",
        "inflation data api"
    ],
    "homepage": "https://apiverve.com/marketplace/inflation?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/inflation",
        "source": "https://github.com/apiverve/inflation-API/tree/main/php"
    },
    "require": {
